{
  "name": "role-signal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:api": "./node_modules/node/bin/node ./node_modules/wrangler/bin/wrangler.js dev --config wrangler.local.jsonc --local --ip 0.0.0.0 --port 8787",
    "db:migrate:local": "./node_modules/node/bin/node ./node_modules/wrangler/bin/wrangler.js d1 migrations apply rolesignal --config wrangler.local.jsonc --local",
    "db:seed:generate": "./node_modules/node/bin/node ./scripts/generate-seed.mjs",
    "data:generate": "./node_modules/node/bin/node ./scripts/generate-countries.mjs",
    "preview:pages": "./node_modules/node/bin/node ./node_modules/wrangler/bin/wrangler.js pages dev dist --ip 0.0.0.0 --port 8788",
    "build": "tsc -b && vite build",
    "check": "tsc -b --pretty false",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit && npm run test:worker",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:smoke": "./node_modules/node/bin/node ./scripts/smoke.mjs",
    "doctor": "./node_modules/node/bin/node ./scripts/doctor.mjs"
  },
  "dependencies": {
    "@bachs/sdk": "^2.0.0",
    "entities": "^8.1.0",
    "fflate": "^0.8.3",
    "franc-min": "^6.2.0",
    "hono": "^4.7.2",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/vitest-plugin": "^1.4.4",
    "@cloudflare/workers-types": "^5.20261016.1",
    "@playwright/test": "^1.64.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "i18n-iso-countries": "^7.14.0",
    "jsdom": "^30.1.3",
    "node": "22.23.3",
    "prettier": "^3.9.10",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.0",
    "wrangler": "^4.151.1"
  }
}
